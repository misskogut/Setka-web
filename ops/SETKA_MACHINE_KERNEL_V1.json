      "RECOVERY_OR_CRYOSLEEP_GATE_CHANGE",
      "NEW_MANDATORY_VENDOR",
      "DESTRUCTIVE_CANONICAL_MUTATION"
    ],
    "noSelfAcceptanceRule": "THE_KERNEL_MAY_PROVE_A_CANDIDATE_BUT_MUST_NOT_DECLARE_ITS_OWN_LAW_CHANGE_ACCEPTED_WHERE_THE_AUTHORITY_CONTRACT_REQUIRES_EXTERNAL_APPROVAL"
  },
  "compilerSignals": {
    "AI_USED_FOR_DETERMINISTIC_REDISCOVERY": "COMPILE_REPEAT_REASONING_TO_MACHINE_RULE_CANDIDATE",
    "BASIN_BOUNDARY_SENSITIVITY": "INCREASE_LOCAL_COUNTERFACTUAL_RESOLUTION",
