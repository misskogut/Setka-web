    "LEAST_VERIFIED_ACTION_SELECTION",
    "AUTHORITY_GATE",
    "COMMIT_OR_REJECT",
    "APPEND_ONLY_PROVENANCE"
  ],
  "ingressPolicy": {
    "kernelDoesNotRequireAIToReadItself": true,
    "arbitraryNaturalLanguageIsNotAssumedDeterministicallyUnambiguous": true,
    "rule": "FREE_TEXT_MAY_BE_NORMALIZED_BY_UI_HUMAN_OR_AI_BUT_THE_KERNEL_ACCEPTS_ONLY_THE_VERSIONED_NORMALIZED_INTENT_CONTRACT",
    "aiBoundary": "AI_MAY_TRANSLATE_AMBIGUOUS_HUMAN_LANGUAGE_TO_INTENT_BUT_MUST_NOT_INVENT_KERNEL_LAWS_OR_BYPASS_MACHINE_VERIFICATION",
    "deterministicPath": "A_COMPLETE_SETKA_SHIP_INTENT_V1_COMPILES_WITHOUT_AI"
  },
  "selfKnowledgeContract": {
    "requiredForEveryOrgan": [
      "ORGAN_ID",
      "VERSION",
      "PURPOSE",
      "INPUTS",
      "OUTPUTS",
      "LAW_REFERENCES",
      "DEPENDENCIES",
      "INVARIANTS",
      "MATERIALIZATION_POLICY",
      "RESOURCE_METRICS",
      "PROVENANCE_REQUIREMENTS",
      "FAIL_CLOSED_RULES"
    ],
    "principle": "AN_ORGAN_IS_NOT_KERNEL_KNOWLEDGE_UNTIL_ITS_BEHAVIORAL_CONTRACT_IS_MACHINE_READABLE_AND_TESTABLE"
  },
  "lawRegistry": {
    "CAUSAL_IRREDUCIBILITY": {
      "role": "MEMORY_BOUNDARY",
      "formula": "STATE(t)=GENESIS+LAW+VARIABLES+CAUSAL_PATCHES<=t+IRREVERSIBLE_INPUTS<=t+REPLAY_CONTRACT",
      "question": "WHAT_INFORMATION_CANNOT_BE_RECONSTRUCTED"
    },
    "STRUCTURAL_IRREDUCIBILITY": {
      "role": "STRUCTURE_BOUNDARY",
      "formula": "STRUCTURE=GENERATOR_LAW+PARAMETERS+DOMAIN_BOUNDARIES+RESIDUAL_EXCEPTIONS+VERIFICATION_PROOF",
      "question": "WHAT_STRUCTURE_CANNOT_BE_REGENERATED_FROM_A_SMALLER_EXACT_LAW"
    },
    "COMPUTATIONAL_IRREDUCIBILITY": {
      "role": "COMPUTE_BOUNDARY",
      "formula": "NEW_RESULT=VERIFIED_PREVIOUS_RESULT+PROVEN_CAUSAL_DELTA_WHERE_DEPENDENCIES_ARE_COMPLETE",
      "question": "WHAT_GENUINELY_MUST_BE_RECOMPUTED"
    },
    "MINIMUM_SUFFICIENT_DISCLOSURE": {
      "role": "DISCLOSURE_BOUNDARY",
      "formula": "UPLINK=MINIMUM_CAUSAL_RESULT_REQUIRED_BY_RECIPIENT+ALLOWED_PROVENANCE",
      "question": "WHAT_GENUINELY_MUST_BE_REVEALED"
    },
    "QUADRATIC_GENERATIVE_GEOMETRY": {
      "role": "SHIP_GENERATOR",
      "formula": "z[n+1]=z[n]^2+c",
      "parameterSpace": "c=Re(c)+i*Im(c)",
      "fullState": "(Re(c),Im(c),Re(z),Im(z))"
    },
    "LOGISTIC_QUADRATIC_CONJUGACY": {
      "role": "BIFURCATION_LINK",
      "formula": "x[n+1]=r*x[n]*(1-x[n]); z=r*(1/2-x); c=r*(2-r)/4"
    },
    "FEIGENBAUM_SCALING": {
      "role": "ASYMPTOTIC_PERIOD_DOUBLING_SCALE_HINT",
      "deltaApprox": 4.66920160910299,
      "alphaApprox": -2.5029078750958928,
      "rule": "ASYMPTOTIC_HINT_ONLY_NOT_EXACT_FINITE_BIFURCATION_GENERATOR"
    },
    "ATTRACTOR_BASIN": {
      "role": "OUTCOME_AND_SENSITIVITY_MAP",
      "newtonFormula": "z[n+1]=z[n]-f(z[n])/f_prime(z[n])",
      "question": "WHICH_ATTRACTOR_DOES_AN_INITIAL_STATE_REACH_AND_HOW_CLOSE_IS_THE_SAMPLED_STATE_TO_A_DIFFERENT_OUTCOME_REGION",
      "rule": "NEWTON_BASIN_IS_THE_FIRST_IMPLEMENTED_METHOD_OF_A_GENERAL_ATTRACTOR_BASIN_ANALYZER_NOT_A_NEW_SHIP_GEOMETRY_LAW"
    },
    "POWER_LAW_SCALING": {
      "role": "SCALE_BEHAVIOR_MODEL",
      "formula": "Y=C*X^alpha",
      "question": "HOW_DO_RESOURCE_CAPABILITY_OR_KNOWLEDGE_METRICS_CHANGE_WITH_SYSTEM_SCALE",
      "rule": "POWER_LAW_IS_A_CANDIDATE_EMPIRICAL_MODEL_AND_REQUIRES_DECLARED_RANGE_UNCERTAINTY_AND_ALTERNATIVE_MODEL_COMPARISON_BEFORE_CONSEQUENTIAL_CANONICAL_USE"
    },
    "LEAST_VERIFIED_ACTION": {
      "role": "PATH_SELECTOR",
      "formula": "gamma*=argmin_gamma_in_VALID A_SETKA(gamma)",
      "rule": "VERIFY_HARD_CONSTRAINTS_FIRST_THEN_MINIMIZE_NORMALIZED_WEIGHTED_WHOLE_HORIZON_RESOURCE_ACTION"
    }
  },
  "capabilityRegistry": {
    "BASE_SHIP": [
      "IDENTITY",
      "CAUSAL_MEMORY",
      "REPLAY",
      "PROVENANCE",
      "RUNTIME_SAFETY",
      "SELF_DIAGNOSTIC"
    ],
    "GENERATIVE_GEOMETRY": ["QUADRATIC_GENERATIVE_GEOMETRY", "FOLD_UNFOLD_MATERIALIZATION"],
    "BIFURCATION": ["LOGISTIC_QUADRATIC_CONJUGACY", "FEIGENBAUM_SCALING"],
    "COUNTERFACTUAL": ["BRANCHING", "SHARED_PREFIX", "LEAST_VERIFIED_ACTION"],
    "ATTRACTOR_ANALYSIS": ["ATTRACTOR_BASIN", "LOCAL_ADAPTIVE_REFINEMENT"],
    "SCALING_ANALYSIS": ["POWER_LAW_SCALING", "PRE_SCALE_GATE"],
    "OPTIMIZATION": ["LEAST_VERIFIED_ACTION", "COMPUTATIONAL_IRREDUCIBILITY"],
    "PRIVACY": ["MINIMUM_SUFFICIENT_DISCLOSURE"],
    "HIERARCHICAL_MEMORY": ["CHILD_LOCAL_LIFE", "PARENT_NOVEL_KNOWLEDGE"]
  },
  "shipCompiler": {
    "intentSchemaVersion": "SETKA_SHIP_INTENT_V1",
    "blueprintSchemaVersion": "SETKA_SHIP_BLUEPRINT_V1",
    "requiredIntentFields": ["intentId", "purpose", "requestedCapabilities", "constraints"],
    "baseOrgansAlwaysIncluded": ["IDENTITY", "CAUSAL_MEMORY", "REPLAY", "PROVENANCE", "RUNTIME_SAFETY", "SELF_DIAGNOSTIC"],
    "unknownCapability": "REVIEW_REQUIRED",
    "unknownConstraint": "REVIEW_REQUIRED",
    "buildRule": "SELECT_ONLY_DECLARED_CAPABILITIES_AND_THEIR_TRANSITIVE_KERNEL_DEPENDENCIES_THEN_VERIFY_BEFORE_BUILD",
    "massRule": "DO_NOT_COPY_THE_WHOLE_KERNEL_INTO_EACH_SHIP_REFERENCE_VERSIONED_LAWS_AND_STORE_ONLY_SHIP_SPECIFIC_PARAMETERS_CAUSES_AND_RESIDUALS",
    "outputRule": "BLUEPRINT_IS_A_DETERMINISTIC_DERIVED_ARTIFACT_UNTIL_AN_AUTHORIZED_COMMIT_MAKES_ANY_IRREVERSIBLE_CHANGE"
  },
  "attractorBasinPolicy": {
    "organPlacement": "GENERATIVE_GEOMETRY_DIAGNOSTIC_PLUS_COUNTERFACTUAL_PRECHECK",
    "newtonIteration": "z_next=z-f(z)/f_prime(z)",
    "outputs": ["ATTRACTOR_ID", "CONVERGENCE_STATE", "ITERATIONS", "RESIDUAL", "SAMPLED_BOUNDARY_DISTANCE_ESTIMATE"],
    "boundaryRule": "NEAR_A_SAMPLED_BASIN_BOUNDARY_INCREASE_LOCAL_COUNTERFACTUAL_SAMPLING_OR_RESOLUTION_BEFORE_A_CONSEQUENTIAL_MUTATION",
    "deepBasinRule": "WHEN_OUTCOME_STABILITY_IS_WELL_SEPARATED_BY_VERIFIED_EVIDENCE_KEEP_UNRELATED_DETAIL_FOLDED",
    "nonGuarantee": "FINITE_SAMPLING_DOES_NOT_PROVE_THE_EXACT_FRACTAL_BOUNDARY_OR_GLOBAL_CONVERGENCE"
  },
  "scalingPolicy": {
    "organPlacement": "SELF_DIAGNOSTIC_PLUS_RESOURCE_PHYSICS_PLUS_LEAST_VERIFIED_ACTION_PRE_SCALE_GATE",
    "model": "Y=C*X^alpha",
    "candidateMetrics": ["CANONICAL_STORAGE", "COMPUTE", "NETWORK", "AI_CALLS", "BRANCH_COST", "RECOVERY_COST", "PARENT_MEMORY", "KNOWLEDGE_GAIN"],
    "interpretation": {
      "alphaLessThanOne": "SUBLINEAR_GROWTH_CANDIDATE",
      "alphaEqualOne": "LINEAR_GROWTH_CANDIDATE",
      "alphaGreaterThanOne": "SUPERLINEAR_GROWTH_RISK_CANDIDATE"
    },
    "parentMemoryTarget": "PARENT_MEMORY_SHOULD_TRACK_NEW_IRREDUCIBLE_KNOWLEDGE_NOT_CHILD_EVENT_COUNT",
    "verificationRule": "A_STRAIGHT_LOOKING_LOG_LOG_PLOT_IS_NOT_PROOF_OF_A_POWER_LAW",
    "consequentialUseRule": "UNBOUNDED_OR_UNVERIFIED_SCALING_ESTIMATES_CANNOT_SILENTLY_WIN_LEAST_VERIFIED_ACTION"
  },
  "selfDevelopmentPolicy": {
    "principle": "THE_SYSTEM_MAY_MEASURE_DIAGNOSE_PROPOSE_SIMULATE_AND_VERIFY_ITS_OWN_IMPROVEMENTS_WITHOUT_REDISCOVERING_KNOWN_LAWS",
    "loop": [
      "MEASURE",
      "DETECT_STABLE_PATTERN_OR_DEFECT",
      "COMPILE_CANDIDATE_RULE_OR_PARAMETER_CHANGE",
      "CREATE_COUNTERFACTUAL_BRANCH",
