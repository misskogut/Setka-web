{
  "schemaVersion": "SETKA_MACHINE_KERNEL_V1",
  "purpose": "MAKE_SETKA_KERNEL_MACHINE_INTERPRETABLE_SO_SHIPS_CAN_BE_COMPILED_FROM_NORMALIZED_HUMAN_INTENT_WITHOUT_AI_READING_OR_REDISCOVERING_KERNEL_LAWS",
