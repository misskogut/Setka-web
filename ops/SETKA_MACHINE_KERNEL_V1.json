      "COMPARE_WITH_BASELINE",
      "APPLY_LEAST_VERIFIED_ACTION",
      "AUTHORITY_GATE",
      "APPEND_ONLY_PROVENANCE"
    ],
    "autoApplyWithinExistingLawEnvelope": [
      "MATERIALIZATION_RESOLUTION",
      "CACHE_OR_REUSE_SELECTION",
      "CHECKPOINT_DENSITY_WHEN_PREAUTHORIZED_AND_RECOVERY_SAFE",
      "LOCAL_EXECUTION_PLAN_SELECTION",
      "COUNTERFACTUAL_SAMPLING_DENSITY"
