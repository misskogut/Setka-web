{
  "schemaVersion": "SETKA_KERNEL_MAP_V2",
  "policy": {
    "kernelDrift": "MANUAL_REVIEW_REQUIRED",
    "automaticTestsDoNotClearManualReview": true,
    "baselineUpdateRequiresReviewedEvidence": true,
    "unknownComponent": "REVIEW_REQUIRED",
    "unclassifiedCoreExecutable": "REVIEW_REQUIRED",
    "structuralHashPurpose": "ATTENTION_ROUTING_ONLY",
    "exactBlobHashRemainsAuthoritative": true,
    "postgresIntegrationState": "NOT_YET_VERIFIED",
    "denseCompactionState": "FORBIDDEN_UNTIL_POST_RECOVERY_PROOF",
    "missionSelfDiagnostic": "DETERMINISTIC_FIRST",
    "missionPolicyPath": "ops/SETKA_KERNEL_MISSION_POLICY.json"
  },
  "complexityPolicy": {
    "preferDeleteMergeOrComputeBeforeCreate": true,
    "newProtectedFileRequiresReview": true,
    "newComponentRequiresReview": true,
    "greenDiagnosticsAreDerivedNotCanonicalHistory": true
  },
  "coverage": {
    "candidatePatterns": [
      "core/**/*.mjs",
      "core/**/*.js",
      "core/**/*.cjs",
      "core/*.mjs",
      "core/*.js",
      "core/*.cjs"
    ],
    "ignorePatterns": []
  },
  "checkGroups": {
    "REPLAY_CORE": { "argv": ["--test", "tests/setka-replay-core.test.mjs"] },
    "REPLAY_PROPERTIES": { "argv": ["--test", "tests/setka-replay-properties.test.mjs"] },
    "RESOURCE_PHYSICS": { "argv": ["--test", "tests/setka-resource-physics.test.mjs"] },
    "GENERATIVE_GEOMETRY": { "argv": ["--test", "tests/setka-generative-geometry.test.mjs"] },
    "LEAST_VERIFIED_ACTION": { "argv": ["--test", "tests/setka-least-verified-action.test.mjs"] },
    "WORKFLOW_SAFETY": { "argv": ["ops/setka-workflow-safety-audit.mjs"] },
    "KERNEL_HANDSHAKE": { "argv": ["ops/setka-kernel-handshake.mjs", "--selftest"] },
    "MISSION_GATE": { "argv": ["ops/setka-mission-gate.mjs", "--check"] }
  },
  "components": {
    "replay_math": {
      "criticality": "HIGH",
      "patterns": [
        "core/replay/**",
        "contracts/setka-replay-contract-v1.schema.json",
        "contracts/setka-causal-event-v1.schema.json",
        "tests/setka-replay-core.test.mjs",
        "tests/setka-replay-properties.test.mjs",
        "ops/setka-runtime-fingerprint.mjs",
        ".github/workflows/setka-node-runtime-differential.yml",
        ".github/workflows/setka-node-runtime-differential.yaml"
      ],
      "excludePatterns": ["core/replay/*.md", "core/replay/**/*.md"],
      "checkGroups": ["REPLAY_CORE", "REPLAY_PROPERTIES", "RESOURCE_PHYSICS", "MISSION_GATE"],
      "externalChecks": ["NODE_RUNTIME_DIFFERENTIAL_ON_RUNTIME_CONTRACT_CHANGE"],
      "manualReviewTargets": ["NUMERIC_SEMANTICS", "EVENT_BOUNDARIES", "HISTORICAL_REPLAY_COMPATIBILITY", "MISSION_ALIGNMENT_AND_PRE_SCALE_GATE"]
    },
    "generative_geometry": {
      "criticality": "HIGH",
      "patterns": [
        "core/geometry/**",
        "contracts/setka-generative-ship-geometry-v1.schema.json",
        "tests/setka-generative-geometry.test.mjs",
        "docs/SETKA_GENERATIVE_SHIP_GEOMETRY_V1.md"
      ],
      "checkGroups": ["GENERATIVE_GEOMETRY", "MISSION_GATE"],
      "manualReviewTargets": [
        "QUADRATIC_AND_NUMERIC_SEMANTICS",
        "PARAMETER_DOMAIN_AND_4D_STATE_SEMANTICS",
        "FOLD_UNFOLD_EXACTNESS",
        "SECTOR_OPERATION_INVARIANTS",
        "COUPLING_DEPENDENCY_COMPLETENESS",
        "FEIGENBAUM_ASYMPTOTIC_ONLY_SEMANTICS",
        "MISSION_ALIGNMENT_AND_PRE_SCALE_GATE"
      ]
    },
    "least_verified_action": {
      "criticality": "HIGH",
      "patterns": [
        "core/optimization/**",
        "contracts/setka-least-verified-action-v1.schema.json",
        "tests/setka-least-verified-action.test.mjs",
        "ops/SETKA_LEAST_VERIFIED_ACTION_POLICY.json",
        "docs/SETKA_LEAST_VERIFIED_ACTION_V1.md"
      ],
      "checkGroups": ["LEAST_VERIFIED_ACTION", "MISSION_GATE"],
      "manualReviewTargets": [
        "HARD_CONSTRAINT_VS_COST_BOUNDARY",
        "COST_NORMALIZATION_AND_WEIGHT_SEMANTICS",
        "EVIDENCE_COMPLETENESS",
        "PARETO_AND_TIE_SEMANTICS",
        "WHOLE_HORIZON_AND_SETUP_COST_SEMANTICS",
        "COUNTERFACTUAL_BRANCH_AND_DELTA_REPLAN_SEMANTICS",
        "NO_FALSE_GLOBAL_OPTIMALITY_CLAIM",
        "MISSION_ALIGNMENT_AND_PRE_SCALE_GATE"
      ]
    },
    "storage_write": {
      "criticality": "HIGH",
      "patterns": [
        "core/storage/**",
        "contracts/setka-causal-event-v1.schema.json",
        "tests/setka-replay-core.test.mjs",
        "tests/setka-resource-physics.test.mjs",
        "ops/SETKA_KERNEL_RESOURCE_BUDGETS.json"
      ],
      "excludePatterns": ["core/storage/*.md", "core/storage/**/*.md"],
      "checkGroups": ["REPLAY_CORE", "RESOURCE_PHYSICS", "MISSION_GATE"],
      "manualReviewTargets": ["CANONICAL_CAUSE_BOUNDARY", "FAIL_CLOSED_BEHAVIOR", "DATABASE_WRITER_MIGRATION_IMPACT", "RESOURCE_BUDGET_SEMANTICS", "MISSION_ALIGNMENT_AND_PRE_SCALE_GATE"]
    },
    "runtime_safety": {
      "criticality": "CRITICAL",
      "patterns": [
        ".github/actions/setka-cryo-gate/**",
        ".github/workflows/*synthetic*.yml",
        ".github/workflows/*synthetic*.yaml",
        ".github/workflows/*simulation*.yml",
        ".github/workflows/*simulation*.yaml",
        ".github/workflows/_setka-synthetic-runner.yml",
        ".github/workflows/_setka-synthetic-runner.yaml",
        "ops/setka-workflow-safety-audit.mjs",
        "ops/SETKA_CRYOSLEEP.yml"
      ],
      "checkGroups": ["WORKFLOW_SAFETY", "MISSION_GATE"],
      "manualReviewTargets": ["NO_UNINTENDED_EXTERNAL_WRITES", "FAIL_CLOSED_CRYOSLEEP", "RESUME_POLICY", "MISSION_ALIGNMENT_AND_PRE_SCALE_GATE"]
    },
    "kernel_governance": {
      "criticality": "HIGH",
      "patterns": [
        "SETKA_KERNEL_MISSION.md",
        "ops/setka-kernel-pulse.mjs",
        "ops/setka-kernel-baseline-guard.mjs",
        "ops/setka-kernel-handshake.mjs",
        "ops/setka-mission-gate.mjs",
        "ops/SETKA_KERNEL_MISSION_POLICY.json",
        "ops/SETKA_KERNEL_RELEASE_MANIFEST.json",
        "ops/SETKA_SUPABASE_KERNEL_SYNC_TODO.md",
        "ops/SETKA_KERNEL_MAP.json",
        ".github/workflows/setka-kernel-pulse.yml",
        ".github/workflows/setka-kernel-pulse.yaml"
      ],
      "checkGroups": ["KERNEL_HANDSHAKE", "MISSION_GATE"],
      "manualReviewTargets": [
        "DRIFT_DETECTION_RULES",
        "COMPONENT_BOUNDARIES",
        "BASELINE_SEMANTICS",
        "UNCLASSIFIED_KERNEL_SURFACE",
        "COMPLEXITY_BUDGET",
        "POSTGRES_RECONCILIATION_POLICY",
        "TRANSCRIPT_PROVENANCE_AND_REVERSAL_POLICY",
        "MISSION_ALIGNMENT_AND_PRE_SCALE_GATE"
      ]
    }
  }
}
